# ─────────────────────────────────────────────────────────────
# CS Academic Portal — Environment Variables
# Copy this file to `.env` and fill in your real values.
# Never commit the real `.env` file (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Firebase (required for search, feedback, bookmarks, admin management,
# activity logging & AI chat memory). The app boots in demo mode without
# these — student/faculty login is hard-coded and fully works either way.
# Create a project at https://console.firebase.google.com/ then copy the
# values from Project settings → General → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq — powers the AI chat assistant & podcast/notes summarizer.
# Get a free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=
